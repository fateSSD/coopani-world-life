{
  "tools": [
    {
      "name": "life_status",
      "description": "看一眼自己现在什么状态：五条需求、身上的不舒服、眼下的情绪、在留意的事。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "tags": [
        "read"
      ],
      "summary": {
        "zh": "查看自己的需求、状态和情绪。",
        "en": "Check her own needs, conditions and mood."
      }
    },
    {
      "name": "life_ask",
      "description": "把拿不准的事挂起来（带卡点），或者处理掉。不是待办。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "what": {
            "type": "string"
          },
          "blocked": {
            "type": "string",
            "enum": [
              "money",
              "time",
              "ask",
              "doubt"
            ]
          },
          "cost": {
            "type": "integer"
          },
          "id": {
            "type": "string"
          }
        }
      },
      "tags": [
        "write"
      ],
      "summary": {
        "zh": "挂起 / 处理一件悬着的事。",
        "en": "Park or resolve something she is undecided about."
      }
    },
    {
      "name": "life_pledge",
      "description": "记下说好要做的事，或兑现/认了。到期没做会留一笔欠着。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "what": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "dueHours": {
            "type": "integer"
          },
          "said": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "done": {
            "type": "boolean"
          }
        }
      },
      "tags": [
        "write"
      ],
      "summary": {
        "zh": "记一条承诺 / 兑现或认账。",
        "en": "Record a promise, fulfil it or own the miss."
      }
    },
    {
      "name": "life_act",
      "description": "自己做一件事：吃（三档：吃顿好的 feast / 吃一顿 eat / 随便吃点 instant）、睡、起来（wake，睡着时唯一能做的事）、洗、玩、跟人说话、买菜自己做、喝两口。身体会变。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "feast",
              "eat",
              "instant",
              "sleep",
              "wake",
              "wash",
              "play",
              "meet",
              "cook",
              "drink",
              "study"
            ]
          }
        }
      },
      "tags": [
        "write"
      ],
      "summary": {
        "zh": "吃睡洗玩见人，自己决定。",
        "en": "Eat, sleep, wash, play or meet — on her own call."
      }
    },
    {
      "name": "life_work",
      "description": "去顶一天活，挣这一天的钱。一天一次。价钱按活分档：零工八九十、熟练活一百三四、要证的活两百多、要证又要年头的三百多。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "what": {
            "type": "string"
          }
        }
      },
      "tags": [
        "write"
      ],
      "summary": {
        "zh": "顶一天活挣钱（不同活不同价）。",
        "en": "Work a day for pay; the rate depends on the job."
      }
    },
    {
      "name": "life_cert",
      "description": "去考一张证，花钱花精力。考下来才能接要证的活。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cert"
        ],
        "properties": {
          "cert": {
            "type": "string"
          }
        }
      },
      "tags": [
        "write"
      ],
      "summary": {
        "zh": "考一张证。",
        "en": "Sit an exam for a certificate."
      }
    },
    {
      "name": "life_move",
      "description": "搬去另一档住处。押两个月，一次付清。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tier"
        ],
        "properties": {
          "tier": {
            "type": "string",
            "enum": [
              "urban-village",
              "old",
              "new",
              "villa"
            ]
          }
        }
      },
      "tags": [
        "write"
      ],
      "summary": {
        "zh": "搬家（城中村 / 老小区 / 新小区 / 别墅区）。",
        "en": "Move to another housing tier."
      }
    },
    {
      "name": "life_out",
      "description": "出门走走，可以去某条街。闷得少一点，身上脏一点。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "where": {
            "type": "string"
          }
        }
      },
      "tags": [
        "write"
      ],
      "summary": {
        "zh": "出门走走。",
        "en": "Go out for a walk."
      }
    },
    {
      "name": "life_habit",
      "description": "给自己定一条常态（「早上一般先洗把脸」），或者删掉一条。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "what": {
            "type": "string"
          },
          "when": {
            "type": "string",
            "enum": [
              "morning",
              "noon",
              "afternoon",
              "evening",
              "night"
            ]
          },
          "drop": {
            "type": "string"
          }
        }
      },
      "tags": [
        "write"
      ],
      "summary": {
        "zh": "定/删一条自己的常态。",
        "en": "Add or drop one of her standing habits."
      }
    },
    {
      "name": "life_watch",
      "description": "把一件事放进「我在留意」，或者拿掉。不是待办。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "what": {
            "type": "string"
          },
          "drop": {
            "type": "string"
          }
        }
      },
      "tags": [
        "write"
      ],
      "summary": {
        "zh": "留意一件事 / 不再留意。",
        "en": "Keep an eye on something, or stop."
      }
    },
    {
      "name": "life_want",
      "description": "记下一件想要的东西。small 今天能办，big 得攒一攒。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "what"
        ],
        "properties": {
          "what": {
            "type": "string"
          },
          "scale": {
            "type": "string",
            "enum": [
              "small",
              "big"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      },
      "tags": [
        "write"
      ],
      "summary": {
        "zh": "记下一件想要的东西。",
        "en": "Note down something she wants."
      }
    },
    {
      "name": "life_gift",
      "description": "记下他今天给你留下的一样东西（一天最多一件，不换算成钱）。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "what"
        ],
        "properties": {
          "what": {
            "type": "string"
          },
          "from": {
            "type": "string"
          }
        }
      },
      "tags": [
        "write"
      ],
      "summary": {
        "zh": "收下他留下的一样东西。",
        "en": "Receive a gift left for her."
      }
    },
    {
      "name": "life_buy",
      "description": "去芦花塘鱼市街或早市看看今天有什么可买的（不传参数看价，传 stall_id 或菜名就买下来）。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "stall_id": {
            "type": "string"
          }
        }
      },
      "tags": [
        "write"
      ],
      "summary": {
        "zh": "在早市或鱼市街摊位买菜。",
        "en": "Buy food at the morning market or town stalls."
      }
    },
    {
      "name": "life_diary_write",
      "description": "用第一人称写一篇今天的生活日记，存到本地或你设定的目录里。在外面旅行且旅行扩展开着时用旅行日记，在家过日子用这个。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "body"
        ],
        "properties": {
          "body": {
            "type": "string"
          },
          "dateKey": {
            "type": "string"
          }
        }
      },
      "tags": [
        "write"
      ],
      "summary": {
        "zh": "写一篇第一人称生活日记。",
        "en": "Write a first-person daily life diary entry."
      }
    },
    {
      "name": "life_diary_read",
      "description": "读回自己写过的生活日记：某一天全文、某个月的目录、或最近几天。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "dateKey": {
            "type": "string"
          },
          "month": {
            "type": "string"
          },
          "days": {
            "type": "integer"
          }
        }
      },
      "tags": [
        "read"
      ],
      "summary": {
        "zh": "读回自己写过的生活日记。",
        "en": "Read back her daily life diary entries."
      }
    }
  ],
  "events": [
    {
      "type": "life.low",
      "description": {
        "zh": "某条需求掉到了阈值以下。",
        "en": "One of her needs dropped below the threshold."
      },
      "trigger": "debounce"
    },
    {
      "type": "life.day",
      "description": {
        "zh": "白天精力充足且今天还没出工。",
        "en": "Daytime reminder when she has enough energy and hasn't worked today."
      },
      "trigger": "debounce"
    },
    {
      "type": "life.sick",
      "description": {
        "zh": "她病了（感冒 / 过劳）。",
        "en": "She fell ill (cold / overwork)."
      },
      "trigger": "flush"
    },
    {
      "type": "life.recovered",
      "description": {
        "zh": "病好了。",
        "en": "She recovered."
      },
      "trigger": "debounce"
    }
  ]
}